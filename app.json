{
  "expo": {
    "name": "Bindr",
    "slug": "bindr-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bindrapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Bindr uses the camera to scan Pokemon cards and assess their condition.",
        "NSLocationWhenInUseUsageDescription": "Bindr uses your location to find nearby collectors who have cards on your wishlist."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#CC0000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Bindr",
      "shortName": "Bindr",
      "display": "standalone",
      "themeColor": "#1B2B5A",
      "backgroundColor": "#EAF4FC",
      "orientation": "portrait"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFF8E7"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Bindr uses the camera to scan Pokemon cards and assess their condition."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bindr uses your location to find nearby collectors who have cards on your wishlist."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
